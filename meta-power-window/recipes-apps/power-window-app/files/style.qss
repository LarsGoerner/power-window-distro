/* ========================================================================== */
/* == POWER WINDOW APP STYLE SHEET ========================================== */
/* ========================================================================== */

/* COLORS
 *
 * Primary Blue:   #0a2342
 * Secondary Blue: #1d3557
 * Tertiary Blue:  #2a4a73
 *
 * Light Blue      #457b9d
 * Muted Gray      #8d99ae
 * Light Gray      #e0e1dd
 *
 * Gold Accent     #d6ad60
 * Emerald Accent  #2a9d8f
 * Red Accent      #e63946
 *
 * White           #f8f9fa
 * Chart Grid      rgba(255, 255, 255, 0.1)
 */

/* == GENERAL STYLE ========================================================= */
*{
        color: #f8f9fa;
        background-color: #0a2342;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
        font-size: 18.0px;
        line-height: 18.0px;
        selection-background-color: #d6ad60;
        selection-color: #1d3557;
}

*:focus {
        outline: none;
}
