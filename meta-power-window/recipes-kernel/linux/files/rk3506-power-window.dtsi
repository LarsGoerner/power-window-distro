/*
 * Common device tree for Power Window
 *
 * RK3506 SoC, 128 MB DDR3L, SD Card, USB Host (USB-A via HUB), USB-C (power + OTG)
 *
 * Derived from rk3506-luckfox-lyra.dtsi (https://github.com/0xd61/luckfox-linux-6.1-rk3506)
 */

#include "rk3506.dtsi"
#include <dt-bindings/input/rk-input.h>
#include <dt-bindings/suspend/rockchip-rk3506.h>
#include <dt-bindings/display/drm_mipi_dsi.h>
#include "rk3506-power-window-pinctrl.dtsi"

/ {
    model = "Power Window (RK3506G2 + Waveshare 5-DSI-TOUCH-A)";
    compatible = "power-window", "rockchip,rk3506";

    firmware {
        optee: optee {
            compatible = "linaro,optee-tz";
            method = "smc";
        };
    };

    leds {
        compatible = "gpios-leds";

        user_led: led-user {
            gpios = <&gpio1 RK_PA0 GPIO_ACTIVE_HIGH>;
            linux,default-trigger = "heartbeat";
            label = "user";
        };
    };

    gpio_keys: gpio-keys {
        compatible = "gpio-keys";
        pinctrl-0 = <&key_wake_up>;
        pinctrl-names = "default";

        wake_up: wake-up {
            label = "Wake-up";
            gpios = <&gpio0 RK_PC1 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_WAKEUP>;
            wakeup-source;
        };
    };

    /* POWER RAILS */
    vcc_sys: vcc-sys {
        compatible = "regulator-fixed";
        regulator-name = "vcc_sys";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
    };
    vcc_3v3: vcc-3v3 {
        compatible = "regulator-fixed";
        regulator-name = "vcc_3v3";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        vin-supply = <&vcc_sys>;
    };
    vcc_1v8: vcc-1v8 {
        compatible = "regulator-fixed";
        regulator-name = "vcc_1v8";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        vin-supply = <&vcc_3v3>;
    };
    vcc_ddr: vcc-ddr { // 1V8
        compatible = "regulator-fixed";
        regulator-name = "vcc_ddr";
        regulator-always-on;
        regulator-boot-on;
        vin-supply = <&vcc_sys>;
    };
    vcc_0v9: vcc-0v9 {
        compatible = "regulator-fixed";
        regulator-name = "vcc_0v9";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <900000>;
        regulator-max-microvolt = <900000>;
        vin-supply = <&vcc_sys>;
    };
    vdd_cpu: vdd-cpu {
        compatible = "regulator-fixed";
        regulator-name = "vdd_cpu";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <900000>;
        regulator-max-microvolt = <900000>;
        vin-supply = <&vcc_sys>;
    };

    fiq_debugger: fiq-debugger {
        compatible = "rockchip,fiq-debugger";
        status = "okay";
        rockchip,serial-id = <0>;
        rockchip,wake-irq = <0>;
        rockchip,irq-mode-enable = <1>;
        rockchip,baudrate = <115200>;
        interrupts = <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH>;
    };
};

/* == CPU =================================================================== */
&cpu0 {
    cpu-supply = <&vdd_cpu>;
    status = "okay";
};

/* == DISPLAY =============================================================== */

&cma {
    size = <0x2000000>;
};

&display_subsystem {
        logo-memory-region = <&drm_logo>;
        status = "okay";
};

&route_dsi { status = "okay"; };
&vop { status = "okay"; };
&rga2 { status = "okay"; };

&dsi {
    status = "okay";
    rockchip,lane-rate = <850>;
    dsi_panel: panel@0 {
        status = "okay";
        compatible = "simple-panel-dsi";
        reg = <0>;
        bpc = <8>;
        prepare-delay-ms = <120>;
        reset-delay-ms = <120>;
        init-delay-ms = <120>;
        disable-delay-ms = <120>;
        unprepare-delay-ms = <120>;
        width-mm = <62>;
        height-mm = <110>;
        backlight = <&ws_bl>;

        dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_HSE | MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS)>;
        dsi,format = <MIPI_DSI_FMT_RGB888>;
        dsi,lanes  = <2>;
         panel-init-sequence = [
            39 00 04 B9 FF 83 94
            39 00 0B B1 48 0A 6A 09 33 54 71 71 2E 45
            39 00 07 BA 61 03 68 6B B2 C0
            39 00 07 B2 00 80 64 0C 06 2F
            39 00 16 B4 1C 78 1C 78 1C 78 01 0C 86
                 75 00 3F 1C 78 1C 78 1C 78 01
                 0C 86
            39 00 22 D3 00 00 00 00 00 00 08 08 32
                 10 05 00 05 32 13 C1 00 01 32
                 10 08 00 00 37 03 07 07 37 05
                 05 37 0C 40
            39 00 2D D5 18 18 18 18 22 23 20 21 04
                 05 06 07 00 01 02 03 18 18 18
                 18 18 18 18 18 18 18 18 18 18
                 18 18 18 18 18 18 18 18 18 18
                 18 19 19 19 19
            39 00 2D D6 18 18 19 19 21 20 23 22 03
                 02 01 00 07 06 05 04 18 18 18
                 18 18 18 18 18 18 18 18 18 18
                 18 18 18 18 18 18 18 18 18 18
                 18 19 19 18 18
            39 00 3B E0 07 08 09 0D 10 14 16 13 24
                 36 48 4A 58 6F 76 80 97 A5 A8
                 B5 C6 62 63 68 6F 72 78 7F 7F
                 00 02 08 0D 0C 0E 0F 10 24 36
                 48 4A 58 6F 78 82 99 A4 A0 B1
                 C0 5E 5E 64 6B 6C 73 7F 7F
            15 00 02 CC 0B
            39 00 03 C0 1F 73
            39 00 03 B6 6B 6B
            15 00 02 D4 02
            15 00 02 BD 01
            15 00 02 B1 00
            15 00 02 BD 00
            39 00 08 BF 40 81 50 00 1A FC 01
            15 00 02 36 00
            05 C8 01 11
            05 50 01 29
        ];

        disp_timings0: display-timings {
            native-mode = <&dsi_timing0>;
            dsi_timing0: timing0 {
                clock-frequency = <70000000>;
                hactive = <720>;
                vactive = <1280>;
                vsync-len = <10>;
                vback-porch = <4>;
                vfront-porch = <30>;
                hsync-len = <20>;
                hback-porch = <20>;
                hfront-porch = <40>;
                vsync-active = <0>;
                hsync-active = <0>;
                de-active = <0>;
                pixelclk-active = <0>;
            };
        };

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0>;
                panel_in_dsi: endpoint {
                    remote-endpoint = <&dsi_out_panel>;
                };
            };
        };
    };

    ports {
        #address-cells = <1>;
        #size-cells = <0>;

        port@1 {
            reg = <1>;
            dsi_out_panel: endpoint {
                remote-endpoint = <&panel_in_dsi>;
            };
        };
    };
};

&dsi_dphy { status = "okay"; };
&dsi_in_vop { status = "okay"; };
&dsi_panel { power-supply = <&vcc_3v3>; };

/* == TOUCH ================================================================= */

&i2c2 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&rm_io1_i2c2_scl &rm_io0_i2c2_sda>;

    gt9xx: gt9xx@5d {
        status = "okay";
        compatible = "goodix,gt911";
        reg = <0x5d>;
        touchscreen-size-x = <720>;
        touchscreen-size-y = <1280>;
        touchscreen-inverted-x;
        touchscreen-inverted-y;
    };

    ws_bl: ws-bl@45 {
        status = "okay";
        compatible = "waveshare,dsi-backlight";
        reg = <0x45>;
        default-brightness-level = <200>;
        max-brightness-level = <255>;
        min-brightness-level = <5>;
    };
};

/* == MEDIA ================================================================= */

&mmc {
    /* for SDMMC */
    status = "okay";
    max-frequency = <52000000>;
    bus-width = <4>;
    no-sdio;
    no-mmc;
    cap-mmc-highspeed;
    cap-sd-highspeed;
    cd-gpios = <&gpio1 RK_PB6 GPIO_ACTIVE_LOW>; // det
    disable-wp;
    pinctrl-0 = <&sdmmc_clk_pins &sdmmc_cmd_pins &sdmmc_bus4_pins &sdmmc_det &sdmmc_pwren>;
    pinctrl-names = "default";
    vqmmc-supply = <&vcc_3v3>;
    vmmc-supply = <&vcc_3v3>;
};

/* == USB =================================================================== */

&usb20_otg0 {
    dr_mode = "peripheral";
    status = "okay";
};

&usb20_otg1 {
    dr_mode = "host";
    status = "okay";
};

&usb2phy { status = "okay"; };
&u2phy_otg0 { status = "okay"; };
&u2phy_otg1 { status = "okay"; };